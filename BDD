Voici la V.1.1 de la BDD :

A copier/coller. 


DROP DATABASE IF EXISTS auto_set;
CREATE DATABASE IF NOT EXISTS auto_set;
USE auto_set;
 
CREATE TABLE client (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nom VARCHAR(100) NOT NULL,
    prenom VARCHAR(100) NOT NULL,
    email VARCHAR(150) UNIQUE,
    telephone VARCHAR(20),
    adresse VARCHAR(255),
    date_inscription DATETIME DEFAULT CURRENT_TIMESTAMP
);
 
CREATE TABLE professionnel (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nom VARCHAR(100) NOT NULL,
    prenom VARCHAR(100) NOT NULL,
    email VARCHAR(150) UNIQUE,
    mot_de_passe VARCHAR(255) NOT NULL,
    telephone VARCHAR(20),
    adresse VARCHAR(255),
    emploi ENUM('Secretariat', 'Mécanicien', 'Directeur', 'Stagiaire') NOT NULL
);
 
CREATE TABLE garage (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nom VARCHAR(100) NOT NULL,
    adresse VARCHAR(255),
    telephone VARCHAR(20),
    email VARCHAR(150) UNIQUE
);
 
CREATE TABLE garage_professionnel (
    garage_id INT NOT NULL,
    professionnel_id INT NOT NULL,
    role VARCHAR(100),
    PRIMARY KEY (garage_id, professionnel_id),
    FOREIGN KEY (garage_id) REFERENCES garage(id),
    FOREIGN KEY (professionnel_id) REFERENCES professionnel(id)
);
 
CREATE TABLE vehicule (
    id INT AUTO_INCREMENT PRIMARY KEY,
    client_id INT NOT NULL,
    categorie VARCHAR(50),
    marque VARCHAR(50),
    modele VARCHAR(50),
    immatriculation VARCHAR(20) UNIQUE,
    kilometrage INT,
    annee_sortie INT,
    date_dernier_controle DATE,
    FOREIGN KEY (client_id) REFERENCES client(id)
);
 
CREATE TABLE controle_technique (
    id INT AUTO_INCREMENT PRIMARY KEY,
    vehicule_id INT NOT NULL,
    professionnel_id INT,
    garage_id INT,
    date_controle DATE NOT NULL,
    type_controle ENUM('Initial', 'Contre-visite') DEFAULT 'Initial',
    resultat ENUM('OK', 'Contre-visite', 'Echec') NOT NULL,
    observations TEXT,
    FOREIGN KEY (vehicule_id) REFERENCES vehicule(id),
    FOREIGN KEY (professionnel_id) REFERENCES professionnel(id),
    FOREIGN KEY (garage_id) REFERENCES garage(id)
);
 
CREATE TABLE rendez_vous (
    id INT AUTO_INCREMENT PRIMARY KEY,
    client_id INT NOT NULL,
    vehicule_id INT NOT NULL,
    professionnel_id INT,
    garage_id INT,
    date_rdv DATETIME NOT NULL,
    type_rdv ENUM('Controle technique', 'Contre-visite') NOT NULL,
    statut ENUM('Prévu', 'Effectué', 'Annulé') DEFAULT 'Prévu',
    FOREIGN KEY (client_id) REFERENCES client(id),
    FOREIGN KEY (vehicule_id) REFERENCES vehicule(id),
    FOREIGN KEY (professionnel_id) REFERENCES professionnel(id),
    FOREIGN KEY (garage_id) REFERENCES garage(id)
);
